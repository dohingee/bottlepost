    "status_appeal_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you think this is a mistake, appeal in Settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘못된 조치라고 생각되면 설정에서 이의를 제기해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誤りだと思われる場合は、設定から異議を申し立ててください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si crees que es un error, apela en Ajustes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se achar que é um engano, recorra em Configurações."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika menurut Anda ini keliru, ajukan banding di Pengaturan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn cho rằng đây là nhầm lẫn, hãy kháng nghị trong Cài đặt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากคิดว่าผิดพลาด โปรดอุทธรณ์ในการตั้งค่า"
          }
        }
      }
    },
    "status_banned": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is permanently suspended for breaking the rules."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운영 정책 위반으로 계정이 영구 정지되었어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
