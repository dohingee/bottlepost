    "onboarding_tagline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send a letter in a bottle to a stranger. Choose who should receive it, and it will drift to someone, somewhere."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낯선 누군가에게 유리병 편지를 띄워 보세요. 받을 사람의 성별만 정하면, 어딘가의 누군가에게 닿을 거예요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見知らぬ誰かにボトルメールを流してみましょう。受け取る人の性別を選ぶだけで、どこかの誰かに届きます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanza una carta en una botella a un desconocido. Elige quién debe recibirla y llegará a alguien, en algún lugar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogue uma carta numa garrafa para um desconhecido. Escolha quem deve recebê-la e ela chegará a alguém, em algum lugar."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirim surat dalam botol kepada orang asing. Pilih siapa yang menerimanya, dan surat itu akan sampai ke seseorang, entah di mana."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thả một lá thư trong chai đến người lạ. Chọn ai sẽ nhận, và lá thư sẽ đến với một người nào đó, ở đâu đó."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งจดหมายในขวดถึงคนแปลกหน้า เลือกว่าใครจะได้รับ แล้วจดหมายจะลอยไปถึงใครสักคน ที่ไหนสักแห่ง"
          }
        }
      }
    },
    "partner_left": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other person has left this conversation."
          }
