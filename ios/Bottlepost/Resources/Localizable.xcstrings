    "leave_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They will see that you left, and no more letters can be sent here. The letters stay on your phone until you delete them."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대방에게 내가 나갔다는 사실이 표시되고, 더 이상 이 대화에 편지를 보낼 수 없어요. 주고받은 편지는 삭제하기 전까지 휴대폰에 남아 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手にはあなたが退出したことが表示され、この会話には手紙を送れなくなります。手紙は削除するまでスマホに残ります。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La otra persona verá que saliste y ya no se podrán enviar cartas aquí. Las cartas seguirán en tu teléfono hasta que las elimines."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A outra pessoa verá que você saiu e não será mais possível enviar cartas aqui. As cartas ficam no seu celular até você excluí-las."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang tersebut akan melihat bahwa Anda keluar, dan surat tidak bisa dikirim lagi di sini. Surat tetap tersimpan di ponsel Anda sampai Anda menghapusnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người kia sẽ thấy bạn đã rời đi và không thể gửi thêm thư ở đây. Thư vẫn được giữ trên điện thoại cho đến khi bạn xóa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อีกฝ่ายจะเห็นว่าคุณออกไปแล้ว และจะส่งจดหมายในบทสนทนานี้ไม่ได้อีก จดหมายจะยังอยู่ในโทรศัพท์จนกว่าคุณจะลบ"
          }
        }
      }
    },
    "leave_done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You left the conversation."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화에서 나갔어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話から退出しました。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Saliste de la conversación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você saiu da conversa."
          }
        },
        "id": {
