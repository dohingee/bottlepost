    "report_consent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To review your report, the letters in this conversation (up to the last 6) will be sent to Bottlepost. The person will also be blocked."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신고를 검토하기 위해 이 대화의 편지(최근 6통까지)가 보틀포스트에 전송돼요. 상대는 자동으로 차단돼요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通報の審査のため、この会話の手紙（最新6通まで）がBottlepostに送信されます。相手は自動的にブロックされます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para revisar tu denuncia, las cartas de esta conversación (hasta las últimas 6) se enviarán a Bottlepost. La persona también será bloqueada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para analisar sua denúncia, as cartas desta conversa (até as últimas 6) serão enviadas ao Bottlepost. A pessoa também será bloqueada."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk meninjau laporan Anda, surat dalam percakapan ini (hingga 6 terakhir) akan dikirim ke Bottlepost. Orang tersebut juga akan diblokir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để xem xét báo cáo, các lá thư trong cuộc trò chuyện này (tối đa 6 thư gần nhất) sẽ được gửi đến Bottlepost. Người đó cũng sẽ bị chặn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อพิจารณารายงาน จดหมายในบทสนทนานี้ (สูงสุด 6 ฉบับล่าสุด) จะถูกส่งให้ Bottlepost และบุคคลนั้นจะถูกบล็อกด้วย"
          }
        }
      }
    },
    "report_done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thank you. We will review this report."
