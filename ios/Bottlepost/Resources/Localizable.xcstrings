            "state": "translated",
            "value": "Anda keluar dari percakapan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã rời cuộc trò chuyện."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณออกจากบทสนทนาแล้ว"
          }
        }
      }
    },
