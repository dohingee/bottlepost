    "settings_google_explain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link a Google account to keep your account and back up conversations to your own Google Drive. Without it, reinstalling the app erases everything."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구글 계정을 연결하면 계정이 유지되고, 대화를 내 구글 드라이브에 백업할 수 있어요. 연결하지 않으면 앱을 다시 설치할 때 모든 대화가 사라져요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Googleアカウントを連携すると、アカウントを保持し、会話を自分のGoogleドライブにバックアップできます。連携しないと、再インストール時にすべて消えます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vincula una cuenta de Google para conservar tu cuenta y hacer copia de tus conversaciones en tu propio Google Drive. Sin ella, reinstalar la app lo borra todo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vincule uma conta Google para manter sua conta e fazer backup das conversas no seu próprio Google Drive. Sem isso, reinstalar o app apaga tudo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautkan akun Google untuk mempertahankan akun dan mencadangkan percakapan ke Google Drive Anda sendiri. Tanpa itu, memasang ulang aplikasi akan menghapus semuanya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết tài khoản Google để giữ tài khoản và sao lưu cuộc trò chuyện vào Google Drive của riêng bạn. Nếu không, cài lại ứng dụng sẽ xóa mọi thứ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมบัญชี Google เพื่อเก็บบัญชีไว้และสำรองบทสนทนาไปยัง Google Drive ของคุณเอง หากไม่เชื่อม การติดตั้งแอปใหม่จะลบทุกอย่าง"
          }
        }
      }
    },
