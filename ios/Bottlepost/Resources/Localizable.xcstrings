          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi đến"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งถึง"
          }
        }
      }
    },
    "delete_active_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other person has not left this conversation. Deleting it also makes you leave, and they will see that you left. Delete anyway?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대방은 아직 이 대화에 남아 있어요. 삭제하면 대화에서도 나가게 되고, 상대방에게 퇴장한 것으로 표시돼요. 그래도 삭제할까요?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手はまだこの会話に残っています。削除すると会話からも退出し、相手には退出したと表示されます。それでも削除しますか？"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La otra persona no ha salido de esta conversación. Al eliminarla también saldrás y verá que saliste. ¿Eliminar de todos modos?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A outra pessoa não saiu desta conversa. Excluir também faz você sair, e ela verá que você saiu. Excluir mesmo assim?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang tersebut belum keluar dari percakapan ini. Menghapusnya juga membuat Anda keluar, dan dia akan melihat bahwa Anda keluar. Tetap hapus?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người kia chưa rời cuộc trò chuyện này. Xóa cũng khiến bạn rời đi và người kia sẽ thấy bạn đã rời. Vẫn xóa?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อีกฝ่ายยังไม่ได้ออกจากบทสนทนานี้ การลบจะทำให้คุณออกจากบทสนทนาด้วย และอีกฝ่ายจะเห็นว่าคุณออกไปแล้ว ยังต้องการลบไหม"
          }
        }
      }
    },
    "delete_active_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They are still here"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대방이 아직 나가지 않았어요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手はまだ退出していません"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La otra persona sigue aquí"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A outra pessoa ainda está aqui"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dia masih di sini"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người kia vẫn còn ở đây"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อีกฝ่ายยังอยู่ในบทสนทนา"
          }
        }
      }
    },
    "delete_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your profile, conversation links and undelivered letters will be deleted from our server. Letters on this phone will be erased. This cannot be undone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버의 프로필, 대화 연결 정보, 전달 전 편지가 삭제되고 이 휴대폰의 편지도 지워져요. 되돌릴 수 없어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバー上のプロフィール、会話のつながり、未配達の手紙が削除され、このスマホの手紙も消去されます。元に戻せません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán de nuestro servidor tu perfil, los vínculos de conversación y las cartas no entregadas, y se borrarán las cartas de este teléfono. No se puede deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu perfil, os vínculos de conversa e as cartas não entregues serão excluídos do servidor, e as cartas deste celular serão apagadas. Não é possível desfazer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil, tautan percakapan, dan surat yang belum terkirim akan dihapus dari server kami, dan surat di ponsel ini akan dihapus. Tidak dapat dibatalkan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hồ sơ, liên kết trò chuyện và thư chưa gửi tới sẽ bị xóa khỏi máy chủ, thư trên điện thoại này cũng bị xóa. Không thể hoàn tác."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรไฟล์ ข้อมูลการเชื่อมบทสนทนา และจดหมายที่ยังไม่ถึงปลายทางจะถูกลบออกจากเซิร์ฟเวอร์ และจดหมายในโทรศัพท์เครื่องนี้จะถูกลบ ไม่สามารถย้อนกลับได้"
          }
        }
      }
    },
