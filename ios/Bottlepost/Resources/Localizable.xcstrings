    "translate_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translation failed. Check your connection for the first download."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역하지 못했어요. 처음에는 언어팩을 받아야 하니 인터넷 연결을 확인해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳できませんでした。初回は言語パックのダウンロードが必要です。接続を確認してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo traducir. La primera vez se descarga un paquete de idioma; revisa tu conexión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível traduzir. Na primeira vez é baixado um pacote de idioma; verifique a conexão."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal menerjemahkan. Pertama kali perlu mengunduh paket bahasa; periksa koneksi Anda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không dịch được. Lần đầu cần tải gói ngôn ngữ; hãy kiểm tra kết nối."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แปลไม่สำเร็จ ครั้งแรกต้องดาวน์โหลดชุดภาษา โปรดตรวจสอบการเชื่อมต่อ"
          }
        }
      }
    },
