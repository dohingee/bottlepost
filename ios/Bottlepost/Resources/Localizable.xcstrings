        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun Anda ditangguhkan permanen karena melanggar aturan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản của bạn bị khóa vĩnh viễn do vi phạm quy định."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชีของคุณถูกระงับถาวรเนื่องจากละเมิดกฎ"
          }
        }
      }
