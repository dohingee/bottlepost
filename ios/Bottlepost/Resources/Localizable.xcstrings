    "block_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will no longer receive letters from this person and the conversation will close. They will not be told who blocked them."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사람의 편지를 더 이상 받지 않고 대화가 종료돼요. 상대에게 누가 차단했는지는 알리지 않아요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この人からの手紙は届かなくなり、会話は終了します。誰がブロックしたかは相手に通知されません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no recibirás cartas de esta persona y la conversación se cerrará. No se le dirá quién la bloqueó."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não receberá mais cartas desta pessoa e a conversa será encerrada. Ela não saberá quem a bloqueou."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda tidak akan lagi menerima surat dari orang ini dan percakapan akan ditutup. Orang tersebut tidak diberi tahu siapa yang memblokir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ không nhận thư từ người này nữa và cuộc trò chuyện sẽ đóng lại. Người kia sẽ không biết ai đã chặn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณจะไม่ได้รับจดหมายจากคนนี้อีก และบทสนทนาจะถูกปิด อีกฝ่ายจะไม่รู้ว่าใครบล็อก"
          }
        }
      }
    },
