    "compose_placeholder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dear stranger,\n\nWrite about your day, a thought, a question…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낯선 당신에게,\n\n오늘 있었던 일, 문득 든 생각, 궁금한 것을 적어 보세요…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見知らぬあなたへ\n\n今日の出来事、ふと思ったこと、聞いてみたいことを書いてみましょう…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Querido desconocido:\n\nCuéntale tu día, una idea, una pregunta…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Querido desconhecido,\n\nConte sobre seu dia, um pensamento, uma pergunta…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk orang asing,\n\nCeritakan hari Anda, sebuah pikiran, atau pertanyaan…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi người lạ,\n\nHãy kể về ngày của bạn, một suy nghĩ, một câu hỏi…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถึงคนแปลกหน้า\n\nเล่าเรื่องวันนี้ ความคิด หรือคำถามของคุณ…"
          }
        }
      }
    },
    "compose_rules": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Links, phone numbers and messenger IDs are not allowed. Be kind — every letter can be reported."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크, 전화번호, 메신저 아이디는 보낼 수 없어요. 모든 편지는 신고될 수 있으니 따뜻하게 써 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンク、電話番号、メッセンジャーIDは送れません。すべての手紙は通報される可能性があります。思いやりを持って書きましょう。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se permiten enlaces, números de teléfono ni ID de mensajería. Sé amable: cualquier carta puede ser denunciada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Links, telefones e IDs de mensageiros não são permitidos. Seja gentil: toda carta pode ser denunciada."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan, nomor telepon, dan ID messenger tidak diizinkan. Bersikaplah baik — setiap surat bisa dilaporkan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không được gửi liên kết, số điện thoại hay ID ứng dụng nhắn tin. Hãy tử tế — mọi lá thư đều có thể bị báo cáo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ห้ามส่งลิงก์ เบอร์โทร หรือไอดีแอปแชต โปรดใช้ถ้อยคำที่สุภาพ — จดหมายทุกฉบับสามารถถูกรายงานได้"
          }
        }
      }
    },
