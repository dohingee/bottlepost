    "restore_confirm_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your conversations on this phone will be replaced by the backup. Letters received after the last backup will be lost."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰의 대화가 백업 내용으로 바뀌어요. 마지막 백업 이후에 받은 편지는 사라져요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマホの会話がバックアップの内容に置き換わります。最後のバックアップ以降に届いた手紙は失われます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las conversaciones de este teléfono se reemplazarán por la copia. Las cartas recibidas después de la última copia se perderán."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As conversas deste celular serão substituídas pelo backup. Cartas recebidas depois do último backup serão perdidas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Percakapan di ponsel ini akan diganti dengan isi cadangan. Surat yang diterima setelah cadangan terakhir akan hilang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các cuộc trò chuyện trên điện thoại này sẽ được thay bằng bản sao lưu. Thư nhận sau lần sao lưu cuối sẽ bị mất."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บทสนทนาในโทรศัพท์เครื่องนี้จะถูกแทนที่ด้วยข้อมูลสำรอง จดหมายที่ได้รับหลังการสำรองครั้งล่าสุดจะหายไป"
          }
        }
      }
    },
    "restore_confirm_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore from backup?"
          }
