          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบข้อมูลสำรองใน iCloud นี้"
          }
        }
      }
    },
    "ios_icloud_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to iCloud in the Settings app to back up."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업하려면 iPhone 설정에서 iCloud에 로그인해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップするには、設定アプリでiCloudにサインインしてください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para hacer copias, inicia sesión en iCloud en la app Ajustes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para fazer backup, entre no iCloud no app Ajustes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk mencadangkan, masuk ke iCloud di app Pengaturan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để sao lưu, hãy đăng nhập iCloud trong ứng dụng Cài đặt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการสำรองข้อมูล โปรดลงชื่อเข้าใช้ iCloud ในแอปการตั้งค่า"
          }
        }
      }
    },
    "ios_link_explain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link your Apple account to keep your account and back up conversations, encrypted, to your own iCloud. Without it, reinstalling the app erases everything."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 계정을 연결하면 계정이 유지되고, 대화를 암호화해 내 iCloud에 백업할 수 있어요. 연결하지 않으면 앱을 다시 설치할 때 모든 대화가 사라져요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleアカウントを連携すると、アカウントを保持し、会話を暗号化して自分のiCloudにバックアップできます。連携しないと、再インストール時にすべて消えます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vincula tu cuenta de Apple para conservar tu cuenta y hacer una copia cifrada de tus conversaciones en tu propio iCloud. Sin ella, reinstalar la app lo borra todo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vincule sua conta Apple para manter sua conta e fazer backup criptografado das conversas no seu próprio iCloud. Sem isso, reinstalar o app apaga tudo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautkan akun Apple Anda untuk mempertahankan akun dan mencadangkan percakapan secara terenkripsi ke iCloud Anda sendiri. Tanpa itu, memasang ulang aplikasi akan menghapus semuanya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết tài khoản Apple để giữ tài khoản và sao lưu cuộc trò chuyện (được mã hóa) vào iCloud của riêng bạn. Nếu không, cài lại ứng dụng sẽ xóa mọi thứ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมบัญชี Apple เพื่อเก็บบัญชีไว้และสำรองบทสนทนาแบบเข้ารหัสไปยัง iCloud ของคุณเอง หากไม่เชื่อม การติดตั้งแอปใหม่จะลบทุกอย่าง"
          }
        }
      }
    },
    "ios_link_required": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link your Apple account first."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 Apple 계정을 연결해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にAppleアカウントを連携してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero vincula tu cuenta de Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vincule sua conta Apple primeiro."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautkan akun Apple Anda terlebih dahulu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy liên kết tài khoản Apple trước."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดเชื่อมบัญชี Apple ก่อน"
          }
        }
      }
    },
    "ios_restore_apple": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I used Bottlepost before — restore with Apple"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전에 쓰던 계정이 있어요 — Apple로 복원"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前使っていました — Appleで復元"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya usaba Bottlepost — restaurar con Apple"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já usei o Bottlepost — restaurar com Apple"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya pernah memakai Bottlepost — pulihkan dengan Apple"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi đã dùng Bottlepost — khôi phục bằng Apple"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันเคยใช้ Bottlepost — กู้คืนด้วย Apple"
          }
        }
      }
    },
    "ios_switch_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switching deletes the account you are using now, including its conversations on this phone, and your partners will see that you left. If that account has an iCloud backup, its conversations are restored. Switch?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전환하면 지금 쓰는 계정과 이 휴대폰의 대화가 삭제되고, 상대방에게는 퇴장한 것으로 보여요. 그 계정의 iCloud 백업이 있으면 그 대화를 불러와요. 전환할까요?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り替えると、今使っているアカウントとこのスマホの会話は削除され、相手には退出したと表示されます。そのアカウントのiCloudバックアップがあれば、その会話を復元します。切り替えますか？"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al cambiar se elimina la cuenta que usas ahora, incluidas sus conversaciones en este teléfono, y las personas con las que hablas verán que saliste. Si esa cuenta tiene una copia en iCloud, se restaurarán sus conversaciones. ¿Cambiar?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao trocar, a conta que você usa agora é excluída, junto com as conversas neste celular, e as pessoas com quem você conversa verão que você saiu. Se essa conta tiver um backup no iCloud, as conversas serão restauradas. Trocar?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beralih akan menghapus akun yang Anda pakai sekarang beserta percakapannya di ponsel ini, dan lawan bicara Anda akan melihat Anda keluar. Jika akun itu punya cadangan iCloud, percakapannya akan dipulihkan. Beralih?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển đổi sẽ xóa tài khoản bạn đang dùng cùng các cuộc trò chuyện trên điện thoại này, và người kia sẽ thấy bạn đã rời đi. Nếu tài khoản đó có bản sao lưu iCloud, các cuộc trò chuyện sẽ được khôi phục. Chuyển?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสลับจะลบบัญชีที่คุณใช้อยู่และบทสนทนาในโทรศัพท์เครื่องนี้ และอีกฝ่ายจะเห็นว่าคุณออกไปแล้ว หากบัญชีนั้นมีข้อมูลสำรองใน iCloud บทสนทนาจะถูกกู้คืน สลับไหม"
          }
        }
      }
    },
    "ios_switch_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Apple account has another Bottlepost account"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple 계정에는 다른 보틀포스트 계정이 있어요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このAppleアカウントには別のボトルポストアカウントがあります"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta de Apple tiene otra cuenta de Bottlepost"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta Apple tem outra conta do Bottlepost"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun Apple ini punya akun Bottlepost lain"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản Apple này có một tài khoản Bottlepost khác"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชี Apple นี้มีบัญชี Bottlepost อื่นอยู่แล้ว"
          }
        }
      }
    },
    "lang_en": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "English"
          }
        },
        "ko": {
