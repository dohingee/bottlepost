    "onboarding_privacy_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No sign-up needed. We never store your letters: they are deleted from our server as soon as they arrive, and live only on your phone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가입 절차가 없어요. 편지는 서버에 보관하지 않아요. 상대에게 도착하는 즉시 서버에서 지워지고 휴대폰에만 남아요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録は不要です。手紙はサーバーに保存しません。届いた時点でサーバーから削除され、スマホにのみ残ります。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No necesitas registrarte. Nunca guardamos tus cartas: se borran de nuestro servidor en cuanto llegan y solo quedan en tu teléfono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem cadastro. Nunca guardamos suas cartas: elas são apagadas do servidor assim que chegam e ficam só no seu celular."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa pendaftaran. Kami tidak pernah menyimpan surat Anda: surat dihapus dari server begitu tiba dan hanya ada di ponsel Anda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không cần đăng ký. Chúng tôi không lưu thư của bạn: thư bị xóa khỏi máy chủ ngay khi đến nơi và chỉ nằm trên điện thoại của bạn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ต้องสมัครสมาชิก เราไม่เก็บจดหมายของคุณ จดหมายจะถูกลบจากเซิร์ฟเวอร์ทันทีที่ถึงปลายทาง และอยู่แค่ในโทรศัพท์ของคุณ"
          }
        }
      }
    },
