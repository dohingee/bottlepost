          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta está suspendida permanentemente por incumplir las normas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conta foi suspensa permanentemente por violar as regras."
