    "letter_launched": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your bottle is out to sea. When someone replies, it appears in Connections."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편지를 담은 병을 바다에 띄웠어요. 답장이 오면 인연 탭에 나타나요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手紙を入れたボトルを海に流しました。返事が届くと「つながり」に表示されます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu botella ya está en el mar. Cuando alguien responda, aparecerá en Conexiones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua garrafa foi lançada ao mar. Quando alguém responder, ela aparece em Conexões."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Botol Anda sudah berlayar. Saat ada yang membalas, percakapan muncul di Koneksi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chai thư đã được thả ra biển. Khi có người trả lời, nó sẽ xuất hiện trong Kết nối."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปล่อยขวดจดหมายลงทะเลแล้ว เมื่อมีคนตอบกลับ จะปรากฏในสายสัมพันธ์"
          }
        }
      }
    },
    "notification_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
