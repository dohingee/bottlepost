rules_version = '2';

// Clients never write directly: every mutation goes through Cloud Functions (App Check enforced).
// The only client access is reading and deleting letters addressed to the signed-in user, which is
// how a device picks up its mail and removes it from the relay right after storing it locally.
service cloud.firestore {
  match /databases/{database}/documents {
    match /deliveries/{deliveryId} {
      allow get, list: if request.auth != null && resource.data.to == request.auth.uid;
      allow delete: if request.auth != null && resource.data.to == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
